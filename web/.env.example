# ==========================================
# StudyHub Web — Environment Variables
# ==========================================

# Backend Express API URL
# - In Local Development: http://localhost:5000
# - In Production (Render/VPS): https://studyhubbot.onrender.com
# Next.js will proxy all /api/* requests to this URL.
BACKEND_URL=http://localhost:5000

# Telegram Bot username for deep links (e.g. https://t.me/studyhub_resource_bot)
NEXT_PUBLIC_BOT_USERNAME=studyhub_resource_bot

# Official StudyHub Telegram Channel
NEXT_PUBLIC_OFFICIAL_CHANNEL_URL=https://t.me/studyhub_et
NEXT_PUBLIC_OFFICIAL_CHANNEL_USERNAME=studyhub_et

# Web App URL
NEXT_PUBLIC_APP_URL=https://webstudyhub.vercel.app

# (Optional) Direct API URL override
# Leave empty or omitted to use Next.js transparent /api proxy (recommended, avoids CORS)
# NEXT_PUBLIC_API_URL=
